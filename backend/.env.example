# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Exact origin(s) of the website, comma separated, used for CORS and for links in emails. Must be https:// in production.
CLIENT_URL=http://localhost:5173
# Public address of the website for the sitemap and robots.txt. Defaults to the first CLIENT_URL.
SITE_URL=
# How many proxies sit in front of the API. 1 = just the hosting platform's load balancer.
# 2 = your frontend host also proxies /api to the API (Vercel/Netlify rewrites). Wrong values break per-visitor rate limiting.
TRUST_PROXY=1

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/makaanly
# Optional: a separate, disposable database for the integration tests (its collections are emptied between tests)
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/makaanly_test

# ---------- Sign-in ----------
# Signs the short-lived access tokens. At least 32 random characters in production, for example:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# "same-site": the API is reached through the website's own address (a proxy), so cookies are first-party. Recommended.
# "cross-site": the website and API are on different sites; needs SameSite=None cookies, which Safari and Firefox may block.
COOKIE_MODE=same-site

# ---------- Photos (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email ----------
# Without SMTP_HOST, emails are printed in the server console in development and skipped in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Makaanly <no-reply@makaanly.example>"
