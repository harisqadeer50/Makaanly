# Leave empty in development (Vite proxies /api to the backend). In production, either proxy /api through the same host
# (see vercel.json / netlify.toml) or set this to the backend's /api URL, e.g. https://api.example.com/api
VITE_API_URL=

# The public address of the website, used in canonical links, structured data and social tags. Defaults to the current origin.
VITE_SITE_URL=

# Shown on the support and legal pages and in the footer
VITE_COMPANY_NAME=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_COMPANY_ADDRESS=

# The home page shows sample testimonials, clearly labelled as demonstration content. Set to false to hide them.
VITE_SHOW_DEMO_TESTIMONIALS=true
